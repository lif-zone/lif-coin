# lif-kernel systemd control file: dns 53 http 80 https 443 localhost 1842
# sudo systemctl daemon-reload
# sudo systemctl restart lif-kernel
# sudo systemctl status lif-kernel

[Unit]
Description=lif-kernel server: http https dns
After=network.target

[Service]
Type=simple
User=lif
Group=lif
WorkingDirectory=/home/lif/lif-kernel
ExecStart=/usr/bin/node /home/lif/lif-kernel/web/server.js -s
Restart=on-failure
RestartSec=5

# This is the important part – allows binding to ports < 1024
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Optional hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/home/lif # adjust if your app needs write access elsewhere

#Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target

